{
    "preset": "psr12",
    "rules": {
        "php_unit_method_casing": false,
                "concat_space": {
            "spacing": "one"
        },
        "braces_position": {
            "functions_opening_brace": "same_line"
        }
    },
    "exclude":[
        "app/Console",
        "storage"
    ]
}
