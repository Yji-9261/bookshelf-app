{
    "preset": "laravel",
    "rules": {
        "php_unit_method_casing": false,
                "concat_space": {
            "spacing": "one"
        },
        "braces_position": {
            "functions_opening_brace": "same_line"
        }
    },
    "exclude":[
        "storage",
        "bootstrap/cache",
        "public/build",
        "node_modules"   
     ]
}
